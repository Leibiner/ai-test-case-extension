{
  "manifest_version": 3,
  "name": "AI 测试用例设计助手",
  "description": "使用你自己的 AI Key，在本地浏览器中通过对话生成可执行测试用例。",
  "version": "0.3.2",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "AI 测试用例设计助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
